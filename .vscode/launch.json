{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "agentTry：连续对话",
      "type": "debugpy",
      "request": "launch",
      "module": "agent_try",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "agentTry：恢复会话",
      "type": "debugpy",
      "request": "launch",
      "module": "agent_try",
      "cwd": "${workspaceFolder}",
      "args": ["--resume", "${input:conversationId}"],
      "console": "integratedTerminal",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "agentTry：提问 DeepSeek",
      "type": "debugpy",
      "request": "launch",
      "module": "agent_try",
      "cwd": "${workspaceFolder}",
      "args": ["${input:question}"],
      "console": "integratedTerminal",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  ],
  "inputs": [
    {
      "id": "conversationId",
      "type": "promptString",
      "description": "请输入要恢复的会话 ID"
    },
    {
      "id": "question",
      "type": "promptString",
      "description": "请输入要问 DeepSeek 的问题",
      "default": "你好"
    }
  ]
}
